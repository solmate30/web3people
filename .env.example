# Payload
PAYLOAD_SECRET=
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# Local schema push only (never enable in production)
PAYLOAD_DB_PUSH=false

# App / Better Auth
# Production must use the canonical www origin, e.g. https://www.web3people.online
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Optional extra origins (comma-separated)
BETTER_AUTH_TRUSTED_ORIGINS=

# Google OAuth (reader login)
# Redirect URI: {BETTER_AUTH_URL}/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional future providers (not wired yet)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloudinary media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
